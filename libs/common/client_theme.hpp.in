#pragma once

#include <d2d1.h>

namespace ogg::ui::theme {

inline D2D1_COLOR_F hex_color(float r, float g, float b) {
    return D2D1::ColorF(r, g, b, 1.f);
}

// Generated from %LOCALAPPDATA%/OffGridGames/appsettings.json via ogg.sync-settings (build/generated/).
inline D2D1_COLOR_F primary_color() {
    return hex_color(@OGG_PRIMARY_R@f, @OGG_PRIMARY_G@f, @OGG_PRIMARY_B@f);
}

inline D2D1_COLOR_F secondary_color() {
    return hex_color(@OGG_SECONDARY_R@f, @OGG_SECONDARY_G@f, @OGG_SECONDARY_B@f);
}

} // namespace ogg::ui::theme
